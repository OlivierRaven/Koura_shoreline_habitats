# set orders
M_C_data <- Monitoring_CPUE_data
lake_order <- c("Rotorua", "Rotoiti", "Rotoehu", "Rotomā", "Ōkāreka")
M_C_data$Lake <- factor(M_C_data$Lake, levels = lake_order)
fish_order <- c("Presence_Kōura","Presence_Eel","Presence_Kōaro","Presence_Common_smelt","Presence_Bullies","Presence_Catfish","Presence_Goldfish","Presence_Mosquitofish","Presence_Trout")
fish_order_CPUE  <- c("Weighted_CPUE_Kōura","Weighted_CPUE_Eel","Weighted_CPUE_Kōaro","Weighted_CPUE_Common_smelt","Weighted_CPUE_Bullies","Weighted_CPUE_Catfish","Weighted_CPUE_Goldfish","Weighted_CPUE_Mosquitofish","Weighted_CPUE_Trout")
fish_order_BPUE  <- c("Weighted_BPUE_Kōura","Weighted_BPUE_Eel","Weighted_BPUE_Kōaro","Weighted_BPUE_Common_smelt","Weighted_BPUE_Bullies","Weighted_BPUE_Catfish","Weighted_BPUE_Goldfish","Weighted_BPUE_Mosquitofish","Weighted_BPUE_Trout")
# Only the fish variables you actually include in presence_data
fish_order_presence <- c("Presence_Eel", "Presence_Common_smelt", "Presence_Catfish", "Presence_Goldfish")
# Facet labels (publication-ready)
variable_labels <- c(
Substrate_index       = "Substrate index",
Slope_5m              = "Slope to 5 m depth",
Riparian_vegetation   = "Riparian vegetation (%)",
Overhanging_trees     = "Overhanging trees (%)",
Wood_cover            = "Wood cover (%)",
Temperature           = "Surface temperature (°C)",
DO_mgl                = "Dissolved oxygen (mg L\u207b\u00b9)",
pH                    = "pH",
Specific_conductivity = "Specific conductivity (\u00b5S cm\u207b\u00b9)",
Emergent_vegetation   = "Emergent vegetation (%)",
Submerged_vegetation  = "Submerged vegetation (%)",
Presence_Eel          = "Eel presence (proportion of sites)",
Presence_Common_smelt = "Common smelt presence (proportion of sites)",
Presence_Catfish      = "Brown bullhead catfish presence (proportion of sites)",
Presence_Goldfish     = "Goldfish presence (proportion of sites)")
# 1. Environmental data (boxplots)
Env_data <- M_C_data %>%
mutate(Emergent_vegetation  = Emergent_Native + Emergent_Non_Native,
Submerged_vegetation = Submerged_Native + Submerged_Non_Native) %>%
select(Lake, Slope_5m, Riparian_vegetation, Overhanging_trees, Wood_cover,
Substrate_index, Temperature, DO_mgl, pH, Specific_conductivity,
Emergent_vegetation, Submerged_vegetation) %>%
pivot_longer(cols = -Lake,
names_to = "Variable",
values_to = "Value") %>%
mutate(Lake     = factor(Lake, levels = lake_order),
Var_type = "Env")
# 2. Fish presence (bars)
presence_data <- M_C_data %>%
select(
Monitoring_ID, Lake,
Presence_Common_smelt, Presence_Goldfish,
Presence_Eel, Presence_Catfish) %>%
pivot_longer( cols = c(Presence_Common_smelt, Presence_Goldfish,Presence_Eel, Presence_Catfish),
names_to  = "Fish_Type",
values_to = "Presence") %>%
mutate(Lake      = factor(Lake, levels = lake_order),
Fish_Type = factor(Fish_Type, levels = fish_order_presence))
Fish_presence_summary <- presence_data %>%
group_by(Lake, Fish_Type) %>%
summarise(Presence_prop = mean(Presence, na.rm = TRUE), .groups = "drop") %>%
mutate(Variable = as.character(Fish_Type),Value = Presence_prop, Var_type = "Fish") %>%
select(Lake, Variable, Value, Var_type)
# 3. Combine into one dataset
EnvBio_data <- bind_rows(Env_data %>% select(Lake, Variable, Value, Var_type),
Fish_presence_summary) %>%
mutate( Variable = factor(Variable,levels = c("Substrate_index","Slope_5m","Riparian_vegetation","Overhanging_trees",
"Wood_cover","Emergent_vegetation","Submerged_vegetation","Temperature","DO_mgl","pH","Specific_conductivity",fish_order_presence)))
# 4. Single plot with conditional geoms + fixed facet labels
EnvBio_plot <- ggplot(EnvBio_data, aes(Lake, Value)) +
geom_boxplot(data = subset(EnvBio_data, Var_type == "Env")) +
geom_col(data = subset(EnvBio_data, Var_type == "Fish"), fill = "grey40") +
facet_wrap(
~ Variable,
scales = "free_y",
ncol = 3,
labeller = as_labeller(variable_labels))
