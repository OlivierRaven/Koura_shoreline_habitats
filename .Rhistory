Lake, Substrate_index, Slope_5m, Riparian_vegetation, Overhanging_trees, Wood_cover,
Temperature, DO_mgl, pH, Specific_conductivity, Emergent_vegetation, Submerged_vegetation) %>%
pivot_longer(-Lake, names_to = "Variable", values_to = "Value") %>%
mutate(Var_type = "Env")
# fish (bars)
Fish_data <- M_C_data %>%
select(Lake, Presence_Eel, Presence_Common_smelt, Presence_Catfish, Presence_Goldfish) %>%
pivot_longer(-Lake, names_to = "Variable", values_to = "Presence") %>%
group_by(Lake, Variable) %>%
summarise(Value = mean(Presence, na.rm = TRUE), .groups = "drop") %>%
mutate(Var_type = "Fish")
EnvBio_data <- bind_rows(
Env_data %>% select(Lake, Variable, Value, Var_type),
Fish_data) %>%
mutate(
Lake = factor(Lake, levels = lake_order),
Variable = factor(Variable, levels = names(var_lab)))
EnvBio_plot <- ggplot(EnvBio_data, aes(Lake, Value)) +
geom_boxplot(data = subset(EnvBio_data, Var_type == "Env")) +
geom_col(data = subset(EnvBio_data, Var_type == "Fish"), fill = "grey40") +
facet_wrap(~ Variable, scales = "free_y", ncol = 3, labeller = as_labeller(var_lab))
EnvBio_plot
EnvBio_plot
ggsave(file.path(fig_dir, "EnvBio_plot.png"),EnvBio_plot,width = 10, height = 10,dpi = 300)
final_p_occ_smooths
final_plot_occupancy
