    {1}{179.22224pt}\LT@entry 
    {1}{96.94434pt}}
\newlabel{tbl-environmental-biotic-overview-ms}{{2}{16}{Tables}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Overview of environmental and biotic variables measured at littoral sampling sites, including variable descriptions, units, and hypothesised relevance for kōura (\emph  {Paranephrops planifrons}). Variables were selected a priori based on known habitat requirements, physiological constraints, and potential biotic interactions influencing kōura occurrence, abundance, and biomass in lake littoral zones.}}{16}{table.2}\protected@file@percent }
