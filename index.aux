\newlabel{tbl-lake-overview-ms}{{1}{15}{Tables}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Physical, morphometric, and trophic characteristics of the five Rotorua Te Arawa lakes surveyed, including sampling dates and number of littoral sites sampled per lake. Lake surface area, perimeter length, catchment area, depth, elevation, mixing regime, and trophic state for 2024 are derived from the Land, Air, Water Aotearoa (LAWA) (\citeproc {ref-LAWA2025}{2025}) database. Shoreline composition percentages are calculated from useable shoreline only, excluding geothermal and cliff sections.}}{15}{table.1}\protected@file@percent }
\gdef \LT@ii {\LT@entry 
